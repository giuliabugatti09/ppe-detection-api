# Imagem separada e mais leve para o Streamlit — ele não precisa
# de torch/opencv/ultralytics, só das bibliotecas de interface e HTTP.
FROM python:3.13-slim

WORKDIR /app

# Apenas as duas dependências que a interface realmente usa.
RUN pip install --no-cache-dir streamlit requests

COPY streamlit_app.py .

EXPOSE 8501

CMD ["streamlit", "run", "streamlit_app.py", "--server.address=0.0.0.0"]